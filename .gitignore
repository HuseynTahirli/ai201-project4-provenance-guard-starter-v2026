# API keys — never commit these
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Hugging Face model cache
.cache/
models/

# OS noise
.DS_Store
Thumbs.db

# Runtime logs, including the capstone request log. Only .gitkeep is kept so
# the folder exists in a fresh clone.
#
# logs/audit.jsonl was committed before this rule, so git still tracks it and
# its changes still show up. It's graded evidence from units 7 and 8, so keep
# committing it. results/ is still not ignored.
logs/*
!logs/.gitkeep
